# Copy to .env; keep secrets out of source files.
HOST=127.0.0.1
PORT=3000
# Empty means sync disabled. See sources.example.json and docs/product-sync.md.
PRODUCT_SOURCES_FILE=
SYNC_INTERVAL_MINUTES=60
SYNC_STALE_MINUTES=120
# Both are required: changed records are published only after AI review.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional bearer token for the configured supplier API.
SUPPLIER_API_TOKEN=
# Live web discovery (requires a model supporting the web_search tool).
ONLINE_SEARCH_ENABLED=false
OPENAI_SEARCH_MODEL=
# Paid searches: maximum per UTC day, shared by user queries and background work.
ONLINE_SEARCH_DAILY_LIMIT=100
# Number of catalog/search queries refreshed per hourly cycle (durable rotation).
ONLINE_SEARCH_BACKGROUND_BATCH=10
